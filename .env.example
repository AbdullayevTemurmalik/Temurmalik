# Portfolio Environment Configuration
# Edit these values to configure contact links and canonical URL.

# Canonical site URL (used for Open Graph, Twitter Cards, Sitemap, and Schema.org metadata)
NEXT_PUBLIC_SITE_URL=https://temurmalik.dev

# Primary contact email (e.g. contact@temurmalik.dev or personal email).
# Leave blank or unconfigured to automatically omit email links safely in production.
NEXT_PUBLIC_CONTACT_EMAIL=

# Instagram profile URL (e.g. https://instagram.com/your_handle).
# Leave blank or unconfigured to automatically omit Instagram links safely in production.
NEXT_PUBLIC_INSTAGRAM_URL=
